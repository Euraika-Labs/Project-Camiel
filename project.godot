config_version=5

[application]

config/name="Camiel alpha-v0.0.3"
run/main_scene="res://scenes/test_space.tscn"
config/features=PackedStringArray("4.7", "4.7.2")

[audio]

audio/enable_audio_on_mobile=true

[audio_bus_layout]

