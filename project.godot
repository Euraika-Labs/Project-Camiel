; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Camiel"
config/version="0.0.45"
config/release_channel="alpha"
; Existing saves use Godot's original per-platform directory for Camiel.
config/use_custom_user_dir=true
config/custom_user_dir_name="godot/app_userdata/Camiel alpha-v0.0.3"
config/custom_user_dir_name.windows="Godot/app_userdata/Camiel alpha-v0.0.3"
config/custom_user_dir_name.macos="Godot/app_userdata/Camiel alpha-v0.0.3"
config/icon="res://assets/brand/camiel.png"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "4.7.2")
boot_splash/image="res://assets/brand/camiel.png"
boot_splash/stretch_mode=0
boot_splash/bg_color=Color(0.992, 0.961, 0.894, 1)

[audio]

audio/enable_audio_on_mobile=true

[autoload]

AudioManager="*res://scripts/audio_manager.gd"
ProgressTracker="*res://scripts/progress_tracker.gd"
Accessibility="*res://scripts/accessibility.gd"
VoiceManager="*res://scripts/voice_manager.gd"
ScreenLayout="*res://scripts/ui/screen_layout.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

